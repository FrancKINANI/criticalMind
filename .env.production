# Production Environment Configuration for CriticalMind SaaS
# IMPORTANT: Replace all placeholder values with actual production values

# Environment
FLASK_ENV=production
NODE_ENV=production
VERSION=1.0.0

# Security Keys (MUST be changed for production)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_JWT_SECRET_IN_PRODUCTION

# Database Configuration
DATABASE_URL=postgresql://criticalmind_user:CHANGE_THIS_PASSWORD@db:5432/criticalmind_db
POSTGRES_DB=criticalmind_db
POSTGRES_USER=criticalmind_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# Redis Configuration
REDIS_URL=redis://:CHANGE_THIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_THIS_PASSWORD

# Domain Configuration
DOMAIN=criticalmind.app
SSL_EMAIL=admin@criticalmind.app
CORS_ORIGINS=https://criticalmind.app,https://www.criticalmind.app

# API Configuration
VITE_API_URL=https://api.criticalmind.app
API_BASE_URL=https://api.criticalmind.app

# Stripe Configuration (Production Keys)
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# AI Services Configuration
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY

# Email Configuration (Production SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=noreply@criticalmind.app
MAIL_PASSWORD=YOUR_EMAIL_APP_PASSWORD
MAIL_DEFAULT_SENDER=CriticalMind <noreply@criticalmind.app>

# Monitoring and Logging
SENTRY_DSN=YOUR_SENTRY_DSN_URL
LOG_LEVEL=INFO
ENABLE_METRICS=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
BACKUP_S3_BUCKET=criticalmind-backups

# Monitoring Configuration
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# Rate Limiting
RATELIMIT_DEFAULT=500 per hour, 50 per minute

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=/app/uploads

# Session Configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict
PERMANENT_SESSION_LIFETIME=86400

# Security Headers
SECURITY_HEADERS_ENABLED=true

# Performance Configuration
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=gevent
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_MAX_REQUESTS=1000
GUNICORN_TIMEOUT=30

# Database Pool Configuration
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_POOL_TIMEOUT=20
SQLALCHEMY_POOL_RECYCLE=300

# Cache Configuration
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://:CHANGE_THIS_PASSWORD@redis:6379/1
CACHE_DEFAULT_TIMEOUT=300

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=false
ENABLE_TWO_FACTOR=true
ENABLE_EMAIL_VERIFICATION=true

# Analytics and Tracking
GOOGLE_ANALYTICS_ID=YOUR_GA_TRACKING_ID
HOTJAR_ID=YOUR_HOTJAR_ID

# Legal and Compliance
PRIVACY_POLICY_URL=https://criticalmind.app/privacy
TERMS_OF_SERVICE_URL=https://criticalmind.app/terms
GDPR_COMPLIANCE=true

# Support Configuration
SUPPORT_EMAIL=support@criticalmind.app
SUPPORT_PHONE=+1-555-CRITICAL

# Social Media
TWITTER_URL=https://twitter.com/criticalmind
LINKEDIN_URL=https://linkedin.com/company/criticalmind
GITHUB_URL=https://github.com/criticalmind

# Deployment Configuration
DEPLOYMENT_ENVIRONMENT=production
HEALTH_CHECK_TIMEOUT=300
BACKUP_RETENTION_DAYS=30
LOG_RETENTION_DAYS=90

# SSL Configuration
SSL_CERT_PATH=/etc/letsencrypt/live/criticalmind.app/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/criticalmind.app/privkey.pem

# CDN Configuration (if using)
CDN_URL=https://cdn.criticalmind.app
STATIC_URL=https://static.criticalmind.app

# Third-party Integrations
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL

# Business Configuration
COMPANY_NAME=CriticalMind Inc.
COMPANY_ADDRESS=123 Innovation Drive, Tech City, TC 12345
COMPANY_PHONE=+1-555-CRITICAL
COMPANY_EMAIL=hello@criticalmind.app

# Subscription Plans Configuration
FREE_PLAN_LIMIT_MODULES=3
BASIC_PLAN_PRICE=9.99
PRO_PLAN_PRICE=19.99
ENTERPRISE_PLAN_PRICE=49.99

# Content Configuration
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de
TIMEZONE=UTC

# Performance Monitoring
NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_KEY
DATADOG_API_KEY=YOUR_DATADOG_KEY

# Security Scanning
SNYK_TOKEN=YOUR_SNYK_TOKEN

# Container Configuration
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_TAG=latest

# Kubernetes Configuration (if using)
KUBERNETES_NAMESPACE=criticalmind-production
KUBERNETES_CLUSTER=production-cluster

# Load Balancer Configuration
LOAD_BALANCER_IP=YOUR_LOAD_BALANCER_IP
HEALTH_CHECK_PATH=/health

# Database Backup Configuration
DB_BACKUP_FREQUENCY=daily
DB_BACKUP_RETENTION=30
DB_BACKUP_ENCRYPTION=true

# Compliance and Auditing
AUDIT_LOG_ENABLED=true
COMPLIANCE_MODE=strict
DATA_RETENTION_POLICY=7_years

# Emergency Configuration
MAINTENANCE_MODE=false
EMERGENCY_CONTACT=emergency@criticalmind.app
INCIDENT_RESPONSE_TEAM=security@criticalmind.app
